# Writes OUT: a .cpp embedding DIR/<entry>.metal for each entry in ENTRIES (comma-separated).
string(REPLACE "," ";" ENTRIES "${ENTRIES}")
set(body "// Generated by cmake/EmbedMsl.cmake. Do not edit.\n#include <cstring>\nnamespace engine::shaders {\nnamespace {\nstruct Entry { const char* name; const char* msl; };\n")
set(table "")
foreach(entry IN LISTS ENTRIES)
  file(READ ${DIR}/${entry}.metal msl)
  string(APPEND body "const char k_${entry}[] = R\"msl_delim(${msl})msl_delim\";\n")
  string(APPEND table "  {\"${entry}\", k_${entry}},\n")
endforeach()
string(APPEND body "const Entry kEntries[] = {\n${table}};\n}  // namespace\n")
string(APPEND body "const char* find_msl(const char* name) {\n  for (const auto& e : kEntries)\n    if (std::strcmp(e.name, name) == 0) return e.msl;\n  return nullptr;\n}\n}  // namespace engine::shaders\n")
file(WRITE ${OUT} "${body}")
